<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary app branding color (Navy Blue Background) -->
        <item name="colorPrimary">@color/background</item>
        <item name="colorPrimaryVariant">#002244</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Button colors and accents -->
        <item name="colorSecondary">#1A73E8</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- App background -->
        <item name="android:colorBackground">#003366</item>

        <!-- Surface for cards and UI elements -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B3B3B3</item>

        <!-- Icon and accent styling -->
        <item name="android:navigationBarColor">#003366</item>
        <item name="android:statusBarColor">#002244</item>
    </style>
</resources>
