<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer rainbow ring -->
    <item>
        <shape
            android:shape="ring"
            android:useLevel="false">
            <!-- Sweep gradient for rainbow effect: Red -> Green -> Blue -->
            <gradient
                android:angle="90"
                android:centerColor="@color/f_pass_color"
                android:endColor="@color/red"
                android:startColor="@color/light_blue"
                android:type="linear" />
            <!-- Outer ring size -->
            <size
                android:width="80dp"
                android:height="80dp" />
            <!-- Inner radius + thickness for outer ring -->
            <ring
                android:innerRadius="30dp"
                android:thickness="10dp" />
        </shape>
    </item>

    <!-- Inner white ring to create a crisp boundary inside -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape
            android:shape="ring"
            android:useLevel="false">
            <solid android:color="@color/white" />
            <!-- Inner ring size slightly smaller -->
            <size
                android:width="20dp"
                android:height="20dp" />
            <!-- Inner radius + thickness for inner ring -->
            <ring
                android:innerRadius="28dp"
                android:thickness="4dp" />
        </shape>
    </item>

</layer-list>
