<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomSpinner" parent="Widget.AppCompat.Spinner.Underlined">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>
    <style name="ToggleButtonStyle">
        <item name="android:textColor">#666666</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">#D3D3D3</item>
        <item name="android:minWidth">100dp</item>
    </style>
    <style name="FullScreenDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/white</item>
        <item name="android:backgroundTint">@android:color/white</item>
    </style>


    <style name="AddGroupButton">
        <item name="android:layout_width">@dimen/add_button_width</item>
        <item name="android:layout_height">@dimen/add_button_height</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/padding_medium</item>
        <item name="android:paddingEnd">@dimen/padding_medium</item>
        <item name="cornerRadius">@dimen/add_button_corner_radius</item>
        <item name="elevation">@dimen/add_button_elevation</item>
        <item name="animation_enabled">@animator/button_elevation</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@android:color/white</item>
    </style>
</resources>
