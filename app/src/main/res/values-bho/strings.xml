    <string name="app_name">स्प्लिट औरा</string>
    <string name="title1">बिना रुकावट के पेमेंट, आराम से बाँट लीं</string>
    <string name="title2">बिल बाँटीं, पल साझा करीं</string>
    <string name="title3">जुड़ल रहीं, पूरा भरोसा से बाँटीं</string>
    <string name="desc1">हमार ई आसान ऐप रउआ के तोहार निजी आ ग्रुप खर्चा के आसानी से ट्रैक आ बाँटे में मदद करेला। चाहे रउआ दोस्तन के संग खइला-पिना बाँटत होखीं या घर के बिलन के संभालत होखीं, स्प्लिटमेट पक्का करीला कि सभ पेमेंट ठीक से आ सबकर हिसाब से होखे।</string>
    <string name="desc2">अपना खर्चा के रियल टाइम में ट्रैक करीं, ओके बढ़िया से श्रेणीबद्ध करीं, आ खर्चा के नक्शा देखीं। पेमेंट के हिसाब किताब से लेके कुल खर्चा के निगरानी तक, स्प्लिटमेट कागज आ झंझट भरल हिसाब किताब के झंझट से दूर रखेला।</string>
    <string name="desc3">स्प्लिट औरा रउआ के एक जगह पे निजी आ ग्रुप दुनो खर्चा के आसानी से चलावे के सहुलियत देला। खर्चा समूह बनाई, सदस्य जोड़ लीं, आ स्प्लिटमेट अपने आप पेमेंट बाँट के ट्रैक कर दी — ताकि दोस्त, परिवार या सहकर्मी संग खर्चा बाँटे में कुछ छूटे ना।</string>
