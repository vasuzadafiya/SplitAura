<resources>
    <string name="app_name">SplitAura</string>
    <string name="title1">सुगम भूकतान, आसान बाँटवां</string>
    <string name="title2">बिल बाँटो, लम्हा बाँटो</string>
    <string name="title3">जोड़्या रयो, विश्वास सूं बाँटवां</string>
    <string name="desc1">हमारो सुलभ ऐप थाने नी व्यक्तिगत अर समूह खर्चा ने आसानी सूं ट्रैक करबा अर बाँटबा में मदद करे है। चाहे थूं दोस्तां सगै भोजन बाँटां या घर का बिल संभाळां, SplitMate ई सुनिश्चित करे है कि सब भूकतान व्यवस्थित अर सबनै न्यायपूर्ण होवैं।</string>
    <string name="desc2">अपने खर्चां ने रियल टाइम में ट्रैक करो, बेहतर व्यवस्था खातर वर्गीकृत करो, अर थारा खर्चा का ढाँचा देखो। भूकतान के हिस्सा गणणां सूं लै ने समग्र खर्चा पर नजर राखबा तक, SplitMate थारा वित्त ने कागज बिनां अर जटिल गणनां बिनां सरल बनावै है।</string>
    <string name="desc3">SplitAura थाने एके ठाँ पर व्यक्तिगत अर समूह खर्चा ने संभालबा री सुविधा दे है। खर्चा समूह बनाओ, सदस्य जोड़ो, अर SplitMate स्वचालित रूप सूं भूकतान बाँट ने ट्रैक करेगा—सुनिश्चित करतो कि दोस्त, परिवार या सहयोगियों सगै खर्च बाँटबा में कदे कोई बात छूटे।</string>
