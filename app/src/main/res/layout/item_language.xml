<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/languageCardWrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <!-- Actual card using ConstraintLayout for flexibility -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/langCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_lang_card_blue"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp">

        <TextView
            android:id="@+id/languageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hindi"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/languageIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:alpha="0.50"
            android:src="@drawable/ic_tajmahal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/languageName" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Border overlay, default hidden -->
    <View
        android:id="@+id/selectedBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_lang_card_selected"
        android:visibility="gone" />
</FrameLayout>
