    <string name="app_name">SplitAura</string>
    <string name="title1">নিরবচ্ছিন্ন পেমেন্ট,&#10;সহজ ভাগ</string>
    <string name="title2">বিল শেয়ার করুন,&#10;মুহূর্ত শেয়ার করুন</string>
    <string name="title3">সংযুক্ত থাকুন,&#10;আত্মবিশ্বাসের সঙ্গে ভাগ করুন</string>
    <string name="desc1">আমাদের সহজ ব্যবহারের অ্যাপ আপনাকে আপনার ব্যক্তিগত এবং গোষ্ঠী খরচ সহজেই ট্র্যাক ও ভাগ করতে সাহায্য করে। আপনি বন্ধুবান্ধবের সঙ্গে খাবার ভাগ করছেন বা গৃহস্থালী বিল পরিচালনা করছেন, SplitMate নিশ্চিত করে যে সকল পেমেন্ট সঠিকভাবে সংগঠিত এবং সকলের জন্য ন্যায়সঙ্গত।</string>
    <string name="desc2">রিয়েল টাইমে আপনার খরচ ট্র্যাক করুন, উন্নত সংগঠনের জন্য এগুলো শ্রেণিবদ্ধ করুন, এবং আপনার ব্যয়ের ধরণ ভিজ্যুয়ালাইজ করুন। পেমেন্ট শেয়ার হিসাব থেকে শুরু করে সামগ্রিক ব্যয় মনিটরিং, SplitMate আপনার আর্থিক ব্যবস্থাপনা সহজ করে দেয় কাগজপত্র বা জটিল হিসাবের ঝামেলা ছাড়াই।</string>
    <string name="desc3">SplitAura আপনাকে একত্রে ব্যক্তিগত ও গোষ্ঠী খরচ পরিচালনার সুবিধা দেয়। খরচ গোষ্ঠী তৈরি করুন, সদস্য যোগ করুন, এবং SplitMate স্বয়ংক্রিয়ভাবে পেমেন্ট বিতরণ ও ট্র্যাক করে—যা নিশ্চিত করে যে আপনি বন্ধু, পরিবার বা সহকর্মীদের সঙ্গে খরচ ভাগ করার সময় কোনো বিস্তারিত মিস করবেন না।</string>
