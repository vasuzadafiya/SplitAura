    <string name="app_name">SplitAura</string>
    <string name="title1">सीधी पेमेंट, सुलझा हुआ बंटवारा</string>
    <string name="title2">बिल साझा कर, लम्हें बाँट</string>
    <string name="title3">जुड़े रह, बिलकुल भरोसे स बांट</string>
    <string name="desc1">इस सुलझी एप तन्ने तेरे निजी अर समूह के खर्चा ने बिना झंझट के ट्रैक अर बांटण में मद्द करै स। चाहे तू दोस्तां के संग खाणा बांट रया हो या घर के बिल संभाल रया हो, SplitMate पक्का करै स कि सारे पेमेंट एकदम ठीक अर बराबर हों।</string>
    <string name="desc2">अपने खर्चे ने रियल टाइम में ट्रैक कर, उनने बढ़िया ढंग तै श्रेणिबद्ध कर अर खर्चे के ढंग दिखा दे। पेमेंट के हिस्से निकालन ते लेके कुल खर्चा देखण तक, SplitMate तेरी फाइनेंस संभालण ने बिलकुल आसान बना दे स बिना कागज या उलझन भरे हिसाब-किताब के।</string>
    <string name="desc3">SplitAura तन्ने ई आजादी दे स कि तू एक ही जगह ते अपने निजी अर समूह के खर्चा संभाल सके। खर्चा के समूह बना, सदस्य जोड़, अर SplitMate अपने आप पेमेंट बाँटते अर ट्रैक करलेगा—ताकि दोस्त, परिवार या सहकर्मियों के संग खर्च बांटते टाइम कोई भी बात छूटे ना।</string>
