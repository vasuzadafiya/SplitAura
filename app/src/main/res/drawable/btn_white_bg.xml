<!-- button_white_square.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"
        android:color="@android:color/white">
        <shape android:shape="rectangle">
            <solid android:color="#123977" /> <!-- Blue background color -->
            <corners android:radius="2dp" /> <!-- Rounded corners -->
        </shape>
    </item>
    <item android:color="#1D4E89">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="#1D4E89" /> <!-- Blue outline color -->
            <corners android:radius="2dp" /> <!-- Rounded corners -->
        </shape>
    </item>
</selector>
