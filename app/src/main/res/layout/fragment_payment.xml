<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/fragment_padding"
    android:background="@color/gray_100">

    <!-- First CardView for Input Fields and Buttons -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        android:layout_marginTop="@dimen/card_margin_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_internal_padding"
            android:background="@color/light_teal"> <!-- Light accent background -->

            <TextView
                android:id="@+id/tv_balance_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="₹0.00 (Overall Balance)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="@dimen/text_padding_bottom"
                android:textColor="@color/black" />

            <Spinner
                android:id="@+id/spinner_friends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spinner_padding"
                android:background="@drawable/spinner_background"
                android:dropDownSelector="@color/light_purple" />

            <EditText
                android:id="@+id/et_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Amount"
                android:inputType="numberDecimal"
                android:padding="@dimen/edittext_padding"
                android:textSize="16sp"
                android:background="@drawable/edittext_background"
                android:layout_marginTop="@dimen/edittext_margin_top"
                android:textColor="@color/black"
                android:textCursorDrawable="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/button_layout_margin_top"
                android:background="@color/gray_200"> <!-- Light accent background for buttons -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pay Now"
                    android:textSize="14sp"
                    android:padding="@dimen/button_padding"
                    app:cornerRadius="@dimen/button_corner_radius"
                    android:backgroundTint="@color/teal_500"
                    android:textColor="@color/white"
                    android:layout_marginEnd="@dimen/button_margin_end" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pay_qr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pay via QR"
                    android:textSize="14sp"
                    android:padding="@dimen/button_padding"
                    app:cornerRadius="@dimen/button_corner_radius"
                    android:backgroundTint="@color/purple_500"
                    android:textColor="@color/white" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_generate_pdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generate PDF"
                android:textSize="14sp"
                android:padding="@dimen/button_padding"
                app:cornerRadius="@dimen/button_corner_radius"
                android:backgroundTint="@color/blue_500"
                android:textColor="@color/white"
                android:layout_marginTop="@dimen/button_margin_top" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/trans_hist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transaction History"
        app:layout_constraintTop_toBottomOf="@id/card_view"
        android:layout_marginTop="@dimen/section_title_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/black" />

    <!-- Second CardView for RecyclerView displaying past transactions -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        android:layout_marginTop="@dimen/card_margin_top"
        app:layout_constraintTop_toBottomOf="@id/trans_hist"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="@color/light_teal"> <!-- Light accent background -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_transactions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/recycler_padding"
            android:clipToPadding="false"
            android:background="@color/white" /> <!-- Contrasting white background for items -->
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>