<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


        <!-- AppBarLayout holds the collapsing header -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/group_back">

            <!-- CollapsingToolbarLayout enables the collapsing behavior with smooth animation -->
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll|snap|exitUntilCollapsed"
                app:layout_scrollInterpolator="@android:interpolator/fast_out_linear_in">

                <!-- Top Content: Image, Title and Additional Info (collapses with parallax) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_collapseMode="parallax">

                    <!-- First Horizontal Layout for Image and Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/padding_large">

                        <!-- Main Image -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/profile_picture"
                            android:layout_width="@dimen/profile_picture_size"
                            android:layout_height="@dimen/profile_picture_size"
                            android:layout_marginEnd="@dimen/margin_medium"
                            android:contentDescription="@string/profile_picture"
                            android:scaleType="centerCrop"
                            android:src="@drawable/obsmallmen2"
                            app:shapeAppearanceOverlay="@style/CircleImageViewStyle" />

                        <!-- Title -->
                        <TextView
                            android:id="@+id/username_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/welcome_message"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Additional Information -->
                    <LinearLayout
                        android:id="@+id/saving_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/margin_large"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txt_saving"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/balance_amount"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/text_size_extra_large"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/available_bal"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/text_size_medium" />
                    </LinearLayout>

                    <!-- Icon Tray (pinned at the bottom of the CollapsingToolbar) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginTop="@dimen/small_margin"
                        android:orientation="horizontal"
                        app:layout_collapseMode="parallax">

                        <!-- Pay -->
                        <LinearLayout style="@style/IconTrayItemLayout">
                            <ImageButton
                                android:id="@+id/btn_pay"
                                style="@style/IconTrayImageButton"
                                android:contentDescription="@string/pay"
                                android:src="@drawable/ic_pay" />
                            <TextView
                                style="@style/IconTrayText"
                                android:text="@string/pay" />
                        </LinearLayout>

                        <!-- Request -->
                        <LinearLayout style="@style/IconTrayItemLayout">
                            <ImageButton
                                android:id="@+id/btn_refresh"
                            style="@style/IconTrayImageButton"
                            android:contentDescription="@string/refresh"
                                android:src="@drawable/ic_refresh1" />
                            <TextView
                                style="@style/IconTrayText"
                                android:text="@string/refresh" />
                        </LinearLayout>

                        <!-- Top-up -->
                        <LinearLayout style="@style/IconTrayItemLayout">
                            <ImageButton
                                android:id="@+id/btn_add_income"
                                style="@style/IconTrayImageButton"
                                android:contentDescription="@string/top_up"
                                android:src="@drawable/ic_topup" />
                            <TextView
                                style="@style/IconTrayText"
                                android:text="@string/top_up" />
                        </LinearLayout>

                        <!-- Withdraw -->
                        <LinearLayout style="@style/IconTrayItemLayout">
                            <ImageButton
                                android:id="@+id/btn_withdraw_saving"
                                style="@style/IconTrayImageButton"
                                android:contentDescription="@string/withdraw"
                                android:src="@drawable/ic_withdraw" />
                            <TextView
                                style="@style/IconTrayText"
                                android:text="@string/withdraw" />
                        </LinearLayout>

                        <!-- History -->
                        <LinearLayout style="@style/IconTrayItemLayout">
                            <ImageButton
                                android:id="@+id/btn_history"
                                style="@style/IconTrayImageButton"
                                android:layout_width="50dp"
                                android:contentDescription="@string/history"
                                android:src="@drawable/ic_history" />
                            <TextView
                                style="@style/IconTrayText"
                                android:text="@string/history" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Scrolling content below the header -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <!-- Group Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/group_cardview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginVertical="@dimen/default_margin"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header: Groups + View All -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_small"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/padding_medium">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="start"
                                android:text="@string/groups"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_large"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/view_all_groups"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:visibility="gone"
                                android:text="@string/view_all"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_medium" />
                        </LinearLayout>

                        <!-- RecyclerView for Groups -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/group_recyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:nestedScrollingEnabled="false"
                            android:paddingHorizontal="@dimen/padding_medium"
                            android:visibility="visible" />

                        <LinearLayout
                            android:id="@+id/placeholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginBottom="@dimen/default_margin"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/imageView"
                                android:layout_width="200dp"
                                android:layout_height="200dp"
                                android:contentDescription="@string/placeholder_image"
                                android:src="@drawable/group_placeholder" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Let's Begin"
                                android:textColor="@color/f_pass_color"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Create a group to start tracking expenses together."
                                android:textColor="@color/gray"
                                android:textSize="15sp"
                                android:textStyle="italic" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Friends Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/friend_cardview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_marginBottom="@dimen/margin_medium"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Friends Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/margin_small"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/padding_medium">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="start"
                                android:text="@string/peoples"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_large"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- RecyclerView for Friends -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/friend_recyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:nestedScrollingEnabled="false"
                            android:paddingHorizontal="@dimen/padding_medium"
                            android:visibility="visible" />

                        <LinearLayout
                            android:id="@+id/people_placeholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="-20dp"
                            android:layout_marginBottom="@dimen/default_margin"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="250dp"
                                android:layout_height="250dp"
                                android:contentDescription="@string/placeholder_image"
                                android:src="@drawable/people_placeholder" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-40dp"
                                android:gravity="center"
                                android:text="You're all settled!"
                                android:textColor="@color/f_pass_color"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="No pending transactions at the moment."
                                android:textColor="@color/gray"
                                android:textSize="15sp"
                                android:textStyle="italic" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>