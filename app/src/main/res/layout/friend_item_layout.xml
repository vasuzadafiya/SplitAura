<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:padding="8dp">

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/friendProfileImageView"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Friend Name -->
        <TextView
            android:id="@+id/friendNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Friend Name"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/friendProfileImageView"
            app:layout_constraintTop_toTopOf="@id/friendProfileImageView"
            app:layout_constraintEnd_toStartOf="@id/removeFriendButton"
            android:layout_marginStart="8dp" />

        <!-- Friend Email -->
        <TextView
            android:id="@+id/friendEmailTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="friend@example.com"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/friendNameTextView"
            app:layout_constraintTop_toBottomOf="@id/friendNameTextView"
            app:layout_constraintEnd_toEndOf="@id/friendNameTextView" />

        <!-- Remove Button (optional if using swipe-to-delete) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/removeFriendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remove"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
