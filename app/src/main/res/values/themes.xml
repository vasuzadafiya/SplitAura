<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme using Material Components -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/background</item>
        <item name="colorPrimaryVariant">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Accent color -->
        <item name="colorAccent">@color/contrast_orange</item>
        <item name="android:colorBackground">@color/white_blue</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/background</item>
        <!--        <item name="android:textColorSecondary">#B3B3B3</item>-->

        <!-- Surface for cards and UI elements -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>


        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/dark_blue</item>
        <!-- Apply our custom BottomNavigation style -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>

    </style>

    <!-- Custom style for BottomNavigationView -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <!-- Set a background color for the BottomNavigationView (if desired) -->
        <!--        <item name="android:background">@color/f_pass_color</item>-->
        <!-- Use our custom color selector for icons and text -->
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <!-- Optionally, set the active indicator color -->
        <item name="itemTextAppearanceActiveBoldEnabled">true</item>
    </style>

    <style name="CustomLoadingDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="IconTrayItemLayout">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- ImageButton style (size, background, margin) -->
    <style name="IconTrayImageButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <!-- TextView style (color, size) -->
    <style name="IconTrayText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
    </style>



</resources>
